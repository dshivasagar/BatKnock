{
  "expo": {
    "name": "Knockmate",
    "slug": "batknock",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111b21"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.batknock.app",
      "buildNumber": "4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Knockmate uses the microphone to detect and count bat knocking sounds during preparation sessions.",
        "NSCameraUsageDescription": "Knockmate uses the camera to take photos of your bat.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationUsageDescription": "Knockmate sends reminders when your bat is ready for the next preparation phase."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111b21"
      },
      "package": "com.batknock.app",
      "versionCode": 6,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "045ba8e6-a7d0-450f-8e15-a5224f721029"
      }
    },
    "owner": "dshivasagar.auto",
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX",
          "iosAppId": "ca-app-pub-3077501095282358~6703522607"
        }
      ]
    ]
  }
}
